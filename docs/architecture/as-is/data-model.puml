@startuml
title Fortius AS-IS · Modelo de datos
caption Propósito: mostrar las 18 tablas públicas y relaciones estructurales [E06,E07]
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam ArrowColor #17334F
skinparam BackgroundColor #FFFFFF
hide circle
skinparam linetype polyline
entity "auth.users (gestionada)" as users {
 * id : uuid <<PK>>
}
entity "staff" as staff {
 * user_id : uuid <<PK,FK>>
}
entity "adviser_accounts" as adviser {
 * user_id : uuid <<PK,FK>>
 asesor_collection : text
 asesor_id : text <<UNIQUE>>
}
entity "records" as records {
 * collection : text <<PK>>
 * id : text <<PK>>
 data : jsonb
 version : bigint
}
entity "record_references" as refs {
 * source_collection / source_id / field <<PK>>
 target_collection / target_id <<FK>>
}
entity "record_revisions" as revisions {
 * collection / id <<PK>>
}
entity "record_history" as history {
 * id : uuid <<PK>>
 collection / record_id
 snapshot : jsonb
 actor_id
}
entity "rate_limits" as limits
entity "lead_conversions" as conversions {
 * lead_id <<PK,FK>>
 cliente_id <<UNIQUE,FK>>
}
entity "file_uploads" as uploads {
 * id <<PK>>
 bucket / path <<UNIQUE>>
 uploaded_by
}
entity "expedientes" as cases {
 * id <<PK>>
 folio <<UNIQUE>>
 cliente_collection / cliente_id <<FK>>
 asesor_collection / asesor_id <<FK>>
 propiedad_slug
 etapa / version / deleted_at
}
entity "expediente_actividad" as activity {
 * id <<PK>>
 expediente_id <<FK>>
}
entity "formato_drafts" as drafts {
 * id <<PK>>
 expediente_id <<FK>>
 formato_id / data / version
}
entity "formato_emissions" as emissions {
 * id <<PK>>
 draft_id <<FK>>
 snapshot / draft_version / sha256 / path
}
entity "formato_assets" as assets {
 * id <<PK>>
 draft_id <<FK>>
 kind / sha256 / path
}
entity "signed_copies" as signed {
 * id <<PK>>
 emission_id <<FK>>
 sha256 / path
}
entity "comercial_books" as books {
 * id <<PK>>
 data / version
}
entity "comercial_revisions" as bookrev {
 * book_id / version <<PK>>
 data
}
entity "comercial_emissions" as bookpdf {
 * id <<PK>>
 book_id / book_version <<FK>>
 sha256 / path
}
users ||--o| staff
staff ||--o| adviser
records ||--o| adviser : asesor
records ||--o{ refs : fuente y destino
records ||--o{ cases : cliente y asesor
records ||--o{ conversions : lead y cliente
cases ||--o{ activity
cases ||--o{ drafts
drafts ||--o{ emissions
drafts ||--o{ assets
emissions ||--o{ signed
books ||--o{ bookrev
bookrev ||--o{ bookpdf
note bottom of cases
 propiedad_slug se valida con trigger;
 no se dibuja como FK al slug.
end note
note bottom of history
 Historial y tombstones referencian identidad lógica;
 no inventar FK a records que impida conservar borrados.
end note
legend bottom
CONFIRMADO: prefijo omitido fortius_inmuebles_. Auth.users no cuenta entre las 18.
Líneas = FK del núcleo; se omiten FK de actores a Auth para legibilidad.
Columnas seleccionadas, no DDL completo. Las18 tablas sí se incluyen.
endlegend
@enduml
