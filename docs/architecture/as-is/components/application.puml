@startuml
!include <C4/C4_Component>
title Fortius AS-IS · C4 nivel 3
caption Propósito: mostrar responsabilidades dentro de la aplicación [E03–E05,E15–E18]
Container_Boundary(app, "Aplicación Next.js") {
 Component(publicui, "UI pública", "src/app y components", "Inventario, inmuebles, contenido, equipo y herramientas")
 Component(admin, "UI administrativa", "admin/store + workspace-loading", "Edición y estado cliente")
 Component(api, "Route Handlers", "src/app/api", "Transporte, origen, lectura y respuesta de errores")
 Component(auth, "Autenticación", "backend/auth.ts", "Sesión, staff y clientes Supabase")
 Component(records, "Registros y validación", "backend/repository + validation", "Colecciones y RPC versionadas")
 Component(projection, "Proyección pública", "backend/public + public-team", "Allowlist pública y asesores opt-in")
 Component(files, "Archivos", "backend/files.ts", "Staging, tickets y verificación de bytes")
 Component(docs, "Expedientes y formatos", "lib/formatos + API", "Borradores, validación, snapshots y PDF")
 Component(com, "Comercial", "lib/comercial + API", "Libros, revisiones y emisiones")
 Component(finance, "Herramientas financieras", "lib/finance", "Cálculos e informes")
}
Container_Ext(identity, "Supabase Auth", "Servicio", "Identidad")
ContainerDb_Ext(db, "PostgreSQL / REST", "Supabase", "RLS y reglas transaccionales")
ContainerDb_Ext(storage, "Storage", "Supabase", "Archivos")
Rel(publicui, projection, "Lee datos publicables", "Llamadas TS servidor")
Rel(publicui, finance, "Calcula e informa", "TS")
Rel(admin, api, "Consulta y edita", "HTTPS JSON")
Rel(api, auth, "requireStaff", "TS")
Rel(api, records, "CRUD versionado", "TS")
Rel(api, files, "Coordina archivos", "TS")
Rel(api, docs, "Coordina expediente/emisión", "TS")
Rel(api, com, "Coordina libros", "TS")
Rel(auth, identity, "getUser / refresh", "HTTPS")
Rel(auth, db, "Comprueba staff", "HTTPS REST")
Rel(records, db, "Consultas y RPC", "HTTPS")
Rel(projection, db, "RPC pública / consulta opt-in", "HTTPS")
Rel(files, storage, "Carga y descarga", "HTTPS")
Rel(files, db, "Procedencia de carga", "HTTPS")
Rel(docs, db, "Padres, versiones y emisiones", "HTTPS")
Rel(docs, storage, "Activos y PDF", "HTTPS")
Rel(com, db, "Revisiones", "HTTPS")
Rel(com, storage, "PDF", "HTTPS")
SHOW_LEGEND()
footer CONFIRMADO salvo notas expresas. Evidencias: evidence.md.

@enduml
