@startuml
!include <C4/C4_Component>
title Fortius TO-BE · C4 nivel 3
caption Propósito: organizar límites sin duplicar unidades de despliegue
Container_Boundary(app, "Monolito modular") {
 Component(ui, "UI y Route Handlers", "Next.js", "Presentación y transporte")
 Component(identity, "Identidad y permisos", "Dominio / aplicación", "Capacidades, sesión y políticas")
 Component(inventory, "Inventario y publicación", "Dominio / aplicación", "Inmuebles y contrato público")
 Component(crm, "Relaciones comerciales", "Dominio / aplicación", "Leads y clientes")
 Component(ops, "Operaciones", "Dominio / aplicación", "Expedientes y seguimiento")
 Component(docs, "Documentos", "Dominio / aplicación", "Borradores, emisiones y custodia")
 Component(com, "Comercial", "Dominio / aplicación", "Libros y revisiones")
 Component(content, "Contenido y herramientas", "Módulos", "Blog, información y calculadoras")
 Component(adapters, "Adaptadores", "Supabase / PDF", "Implementan puertos de los casos de uso")
}
Container_Ext(supa, "Servicios Supabase", "Auth / REST / Storage", "Persistencia y reglas transaccionales")
Rel(ui, identity, "Autentica y autoriza", "TS")
Rel(ui, inventory, "Caso de uso", "TS")
Rel(ui, crm, "Caso de uso", "TS")
Rel(ui, ops, "Caso de uso", "TS")
Rel(ui, docs, "Caso de uso", "TS")
Rel(ui, com, "Caso de uso", "TS")
Rel(ui, content, "Caso de uso", "TS")
Rel(identity, adapters, "Puerto", "TS")
Rel(inventory, adapters, "Puerto", "TS")
Rel(crm, adapters, "Puerto", "TS")
Rel(ops, adapters, "Puerto", "TS")
Rel(docs, adapters, "Puerto", "TS")
Rel(com, adapters, "Puerto", "TS")
Rel(content, adapters, "Puerto cuando requiere persistencia", "TS")
Rel(adapters, supa, "Acceso autorizado", "HTTPS")
SHOW_LEGEND()
footer PROPUESTO: arquitectura futura, no implementada.

@enduml
