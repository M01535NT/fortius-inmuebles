# Local canonical origin. Set the deployed origin only after it is verified.
FORTIUS_INMUEBLES_SITE_URL=http://localhost:3001
# Public lead writes stay disabled until the dedicated backend is configured.
FORTIUS_INMUEBLES_PUBLIC_LEADS_ENABLED=false
# Dedicated Fortius Inmuebles project only. No cross-product fallback exists in this backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase API secret (sb_secret_* or legacy service_role key).
# Required for lead ingestion/rate limits and validated file staging/finalization.
# Never expose through NEXT_PUBLIC or send this secret to browsers.
SUPABASE_SERVICE_ROLE_KEY=

# Adviser apps: server only. Keep disabled until accounts and verified cost ceilings exist.
FORTIUS_APPS_ENABLED=false
FORTIUS_APPS_BUDGET_MXN=2000
FORTIUS_APPS_FIXED_MONTHLY_MXN=200
FORTIUS_APPS_RESERVE_MXN=400
FORTIUS_APPS_USD_MXN=
FORTIUS_APPS_TAX_RATE=
FORTIUS_APPS_PRICE_VERIFIED_AT=
FORTIUS_APPS_OCR_PAGE_USD=
FORTIUS_APPS_AI_REQUEST_MAX_USD=
FORTIUS_APPS_ROUTES_USD=
FORTIUS_APPS_SIGNATURE_MAX_USD=
DOCUSEAL_API_KEY=
DOCUSEAL_WEBHOOK_SECRET=
DOCUSEAL_ARTIFACT_HOSTS=
OPENAI_API_KEY=
GOOGLE_DOCUMENT_AI_PROJECT=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_ROUTES_API_KEY=
