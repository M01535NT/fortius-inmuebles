# Local canonical origin. Set the deployed origin only after it is verified.
FORTIUS_INMUEBLES_SITE_URL=http://localhost:3001
# Public lead writes stay disabled until the dedicated backend is configured.
FORTIUS_INMUEBLES_PUBLIC_LEADS_ENABLED=false
# Dedicated Fortius Inmuebles project only. No cross-product fallback exists in this backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase API secret (sb_secret_* or legacy service_role key).
# Required for lead ingestion/rate limits and validated file staging/finalization.
# Never expose through NEXT_PUBLIC or send this secret to browsers.
SUPABASE_SERVICE_ROLE_KEY=
# Lectura con IA de los documentos del cliente (IA-01). Server-only; sin clave, la lectura queda desactivada.
# Activar solo con el visto bueno del abogado sobre el aviso de privacidad. Nunca con prefijo NEXT_PUBLIC.
ANTHROPIC_API_KEY=
# Modelo de Claude para la lectura (claude-opus-5-5 si se deja vacío; el titular usa claude-haiku-5-5 en pruebas).
ANTHROPIC_MODELO=
# Tope de gasto mensual de las lecturas, en dólares (20 si se deja vacío).
IA_TOPE_MENSUAL_USD=
# Proveedor alterno de lectura: xAI (Grok). Solo lee imágenes JPG/PNG/WEBP (no PDF). Server-only, nunca NEXT_PUBLIC.
XAI_API_KEY=
# Modelo de xAI (grok-4.7 si se deja vacío).
XAI_MODELO=
# Qué servicio lee: «claude» o «grok». Vacío: el que tenga clave, Claude primero.
IA_PROVEEDOR=

# --- Solo pruebas y desarrollo (opcionales; déjalas comentadas si no las usas) ---
# Permite abrir el servidor de desarrollo desde una vista previa en la nube (next.config.ts).
# FORTIUS_INMUEBLES_CLOUD_PREVIEW=true
# Origen que revisan las pruebas del panel y tests/live (obligatoria para npm run test:live).
# FORTIUS_INMUEBLES_TEST_URL=http://localhost:3001
# Proyecto de Supabase que usa tests/live; crea y borra datos: nunca el de producción.
# FORTIUS_INMUEBLES_TEST_PROJECT_REF=
# tests/live envía los cinco formularios públicos de verdad (escribe prospectos).
# FORTIUS_INMUEBLES_TEST_PRODUCTION_LEADS=false
# Puerto del backend simulado de la suite pública de navegador (3101 si se deja vacío).
# FORTIUS_INMUEBLES_FIXTURE_PORT=3101
# Activa la medición de Lighthouse en home-experience.spec.ts.
# FORTIUS_INMUEBLES_RUN_LIGHTHOUSE=true
# Ruta donde tests/backend/apps-pdf.test.ts guarda el PDF de muestra para revisarlo.
# FORTIUS_QA_PDF=tmp/muestra.pdf
