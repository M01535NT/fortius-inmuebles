# Local canonical origin. Set the deployed origin only after it is verified.
FORTIUS_INMUEBLES_SITE_URL=http://localhost:3001
# Public lead writes stay disabled until the dedicated backend is configured.
FORTIUS_INMUEBLES_PUBLIC_LEADS_ENABLED=false
# Dedicated Fortius Inmuebles project only. No cross-product fallback exists in this backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase API secret (sb_secret_* or legacy service_role key).
# Required for lead ingestion/rate limits and validated file staging/finalization.
# Never expose through NEXT_PUBLIC or send this secret to browsers.
SUPABASE_SERVICE_ROLE_KEY=
